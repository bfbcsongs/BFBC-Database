<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BFBC SONGS DATABASE by paulm</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Supabase JS Client CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans flex flex-col">

    <!-- Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-md">
        <div class="max-w-4xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-2">
            <a href="#" class="flex items-center space-x-2">
                <i class="fa-solid fa-music text-indigo-400 text-2xl"></i>
                <h1 class="text-xl font-bold tracking-wide text-white">BFBC SONGS DATABASE</h1>
            </a>
            <span class="text-xs text-indigo-300 font-medium px-2.5 py-1 bg-slate-700/60 rounded-full border border-slate-600">
                by paulm
            </span>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-6 flex-grow w-full">
        
        <!-- Search Section -->
        <div class="relative mb-6">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <input 
                type="text" 
                id="search-input"
                placeholder="Search songs by title, lyrics, or number..." 
                class="w-full pl-10 pr-4 py-3 bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner"
            >
        </div>

        <!-- Categories Filter Buttons -->
        <div class="mb-8">
            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Categories</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-7 gap-2" id="category-buttons">
                <button data-category="All" class="category-btn active bg-indigo-600 text-white font-medium py-2 px-3 rounded-lg text-sm transition-all shadow hover:bg-indigo-500 text-center">
                    All
                </button>
                <button data-category="Opening" class="category-btn bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700 font-medium py-2 px-3 rounded-lg text-sm transition-all text-center">
                    Opening
                </button>
                <button data-category="Joyful" class="category-btn bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700 font-medium py-2 px-3 rounded-lg text-sm transition-all text-center">
                    Joyful
                </button>
                <button data-category="Solemn" class="category-btn bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700 font-medium py-2 px-3 rounded-lg text-sm transition-all text-center">
                    Solemn
                </button>
                <button data-category="Offering" class="category-btn bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700 font-medium py-2 px-3 rounded-lg text-sm transition-all text-center">
                    Offering
                </button>
                <button data-category="Closing" class="category-btn bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700 font-medium py-2 px-3 rounded-lg text-sm transition-all text-center">
                    Closing
                </button>
                <button data-category="Others" class="category-btn col-span-2 sm:col-span-1 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700 font-medium py-2 px-3 rounded-lg text-sm transition-all text-center">
                    Others
                </button>
            </div>
        </div>

        <!-- Songs List Container -->
        <section>
            <div class="flex justify-between items-center mb-4">
                <h2 id="current-category-title" class="text-lg font-semibold text-slate-200">All Songs</h2>
                <span id="song-count" class="text-xs text-slate-400">0 songs found</span>
            </div>

            <!-- Song List placeholder (will be populated dynamically) -->
            <div id="songs-list" class="space-y-3">
                <!-- Example Placeholder Card -->
                <div class="p-4 bg-slate-800 border border-slate-700/60 rounded-xl hover:border-slate-600 transition-all cursor-pointer flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-slate-100">Sample Song Title</h3>
                        <p class="text-xs text-slate-400 mt-1">First line of lyrics or preview snippet...</p>
                    </div>
                    <span class="text-xs px-2.5 py-1 bg-indigo-950/80 text-indigo-300 border border-indigo-800/50 rounded-full">
                        Opening
                    </span>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-800/50 border-t border-slate-800 py-4 text-center text-xs text-slate-500">
        <p>&copy; <span id="year"></span> BFBC SONGS DATABASE by paulm. All rights reserved.</p>
    </footer>

    <!-- App Logic Script -->
    <script>
        // Set current year in footer
        document.getElementById('year').textContent = new Date().getFullYear();

        // Optional: Initialize Supabase Client (Fill in your details from Supabase Dashboard)
        // const SUPABASE_URL = 'YOUR_SUPABASE_URL';
        // const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';
        // const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        // UI Interactions (Category Toggle)
        const categoryButtons = document.querySelectorAll('.category-btn');
        const categoryTitle = document.getElementById('current-category-title');

        categoryButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Remove active styling from all buttons
                categoryButtons.forEach(btn => {
                    btn.classList.remove('bg-indigo-600', 'text-white');
                    btn.classList.add('bg-slate-800', 'text-slate-300', 'border', 'border-slate-700');
                });

                // Add active styling to clicked button
                button.classList.remove('bg-slate-800', 'text-slate-300', 'border', 'border-slate-700');
                button.classList.add('bg-indigo-600', 'text-white');

                // Update section header
                const selectedCategory = button.getAttribute('data-category');
                categoryTitle.textContent = selectedCategory === 'All' ? 'All Songs' : `${selectedCategory} Songs`;
                
                // TODO: Add logic here to filter songs by category from Supabase or memory
            });
        });
    </script>
</body>
</html>
